NEXT_PUBLIC_TENANT_KEY=demo
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional server-only URL when Next.js runs in Docker but the browser runs on the host.
CMS_API_INTERNAL_URL=
NEXT_PUBLIC_ADMIN_THEME={}
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MODULE_PRESET=general_business
# Demo mode enables every module and uses browser-local data. Set this list only
# when connecting to a specific backend tenant.
NEXT_PUBLIC_ENABLED_MODULES=[]
